# ============================================================
# MASHHII — Environment Configuration
# ============================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.

# ── DATABASE ─────────────────────────────────────────────────
# PostgreSQL connection string (Neon Serverless recommended)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── AUTHENTICATION ────────────────────────────────────────────
# Generate with: openssl rand -hex 32
AUTH_SECRET="your-secret-here"

# Google OAuth credentials from console.cloud.google.com
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# The ONLY Gmail address allowed to access this application
ALLOWED_EMAIL="your-email@gmail.com"

# ── VERCEL BLOB ───────────────────────────────────────────────
# Vercel Blob storage token (from Vercel Dashboard > Storage > Blob)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ── APPLICATION ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Mashhii"

# ── NEXT AUTH URL ─────────────────────────────────────────────
# Required in production, auto-detected in development
# NEXTAUTH_URL="https://your-domain.vercel.app"
